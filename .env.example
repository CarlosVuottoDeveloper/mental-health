# Copie para .env.local e preencha. Nunca versione valores reais.
# Na Vercel (LPC-7), cadastre as mesmas variáveis em Settings > Environment Variables.

# WhatsApp da clínica: código do país + DDD + número, só dígitos (LPC-18).
NEXT_PUBLIC_WHATSAPP_NUMBER=5511900000000

# URL pública do site, usada em metadata, Open Graph, sitemap e canonical (LPC-20/21).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "true" libera a indexação por buscadores. Mantenha vazio no portfólio (decisão D7).
NEXT_PUBLIC_SITE_INDEXABLE=

# GA4: ID de medição (G-XXXXXXXXXX). Carregado só após o aceite de cookies (LPC-24/26).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Envio do formulário de contato via Resend (LPC-17). Só no servidor.
RESEND_API_KEY=
# Remetente verificado no Resend e destinatário das mensagens.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
